# NOTE: Cloudflare Pages `_headers` applies to STATIC ASSET responses only, NOT to
# responses produced by the Worker (SSR HTML + server functions). Security headers
# for those are set in src/server.ts. This file covers static files.
# HSTS is set in src/server.ts; consider also enabling it at the Cloudflare zone level.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Root static images are not fingerprinted, so give them a moderate cache
# (was max-age=0). The homepage now uses the responsive /hero/* files; the PNG
# original is kept only for old links.
/parc-auto.png
  Cache-Control: public, max-age=2592000
/favicon-96x96.png
  Cache-Control: public, max-age=2592000
/og-image.jpg
  Cache-Control: public, max-age=2592000
/sal-pictograma.png
  Cache-Control: public, max-age=2592000
/hero/*
  Cache-Control: public, max-age=2592000
# Self-hosted font files never change in place (a new version gets a new name).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
